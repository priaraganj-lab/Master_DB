# ===== SOURCE DATABASES (read-only) =====
# mongodb_network_data: network transactions/catalogs (15 Beckn DBs) | mongodb_elevate_atlas: Elevate (samiksha, project, diksha, notification, Mobident, telemetry)
# postgresql_supabase: Supabase (postgres, mentoring, scp) | postgresql_network_telemetry: global_registry server (only telemetry.events is ingested)
mongodb_network_data=mongodb://HOST:27017
mongodb_elevate_atlas=mongodb+srv://USER:PASSWORD@CLUSTER/DBNAME?retryWrites=true&w=majority
postgresql_supabase=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres?sslmode=require
postgresql_network_telemetry=postgresql+psycopg2://USER:PASSWORD@HOST:5434/global_registry

# ===== TARGET DATABASE (written by the pipeline) =====
# If CRL_MASTER_DB_URL is unset, postgresql_network_telemetry's server/credentials are reused with CRL_MASTER_DB_NAME.
# CRL_MASTER_DB_NAME=crl_master_db
CRL_MASTER_DB_URL=postgresql://USER:PASSWORD@HOST:5434/crl_master_db

# Tuning (optional)
# INGEST_CHUNK_SIZE=2000
# CONNECT_TIMEOUT_SECONDS=20
# LOG_DIR=logs
# LOG_LEVEL=INFO

# API telemetry sources (disabled until *_BASE_URL is set). X = CHATBOT | INTERFACE
# API_X_BASE_URL=https://example.org
# API_X_ENDPOINT=/telemetry/events
# API_X_AUTH_TYPE=none            # none | bearer | header
# API_X_AUTH_TOKEN=
# API_X_AUTH_HEADER=X-API-Key     # header name when AUTH_TYPE=header
# API_X_RECORDS_KEY=data.items    # dotted path to the list in the response; empty = response is a list
# API_X_ID_FIELD=id               # field used as source_record_id
# API_X_TIMESTAMP_FIELD=timestamp # field used as source_timestamp / watermark
# API_X_SINCE_PARAM=since         # query param carrying the watermark
# API_X_PAGE_PARAM=page           # page-number param (omit if unpaginated)
# API_X_PAGE_SIZE_PARAM=limit
# API_X_PAGE_SIZE=500
# API_X_MAX_PAGES=1000
